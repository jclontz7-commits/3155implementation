{
  "name": "campus-research-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite --open /applicants.html",
    "build": "npm run db:generate && npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "npm run db:generate && tsx --test tests/*.test.ts && vitest run src --passWithNoTests",
    "db:start": "docker compose up -d db",
    "db:stop": "docker compose stop db",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:init": "tsx scripts/db-init.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:verify": "tsx scripts/verify.ts",
    "db:status": "prisma migrate status",
    "test:db": "tsx scripts/test-db.ts",
    "start": "npm run build && tsx src/server.ts",
    "lint": "eslint src scripts tests prisma.config.ts vite.config.ts && node --check messaging.js && node --check app.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "dotenv": "^17.0.0",
    "pg": "^8.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^10.15.0",
    "jsdom": "^31.0.1",
    "prisma": "^7.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.1.7",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.1.0"
  }
}
