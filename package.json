    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.4",
    "prisma": "^7.10.1",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vitest": "^5.1.0"
  }
