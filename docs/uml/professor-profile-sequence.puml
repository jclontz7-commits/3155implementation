@startuml
skinparam shadowing false
skinparam backgroundColor white
skinparam sequenceMessageAlign center
title Issue #4 — implemented professor profile save
actor Professor
boundary "professor.js\nEditor" as UI
control "Local Node server\nSession + API" as API
control "createDataAccess(db)\nPrisma repository" as DAL
database PostgreSQL as DB
note over Professor,DB
  Local development: a server-selected synthetic professor signs in.
  HttpOnly session cookie; same-origin writes; no browser owner selection.
end note
Professor -> UI: Edit fields and select Save
UI -> UI: Validate required fields; preserve input
UI -> API: PATCH /api/professor/profile\nfields + expectedVersion + session cookie
API -> API: Verify host/origin, session, JSON and body limit
alt Missing session
  API --> UI: 401
  UI --> Professor: Return to sample sign-in
else Session present
  API -> DAL: updateProfessorProfile(serverSelectedId, input)
  DAL -> DB: Read stored actor role
  DB --> DAL: User or missing
  DAL -> DAL: Require PROFESSOR; validate strict allowlisted fields
  alt Role/input invalid
    DAL --> API: Forbidden or validation error
    API --> UI: 403 / 422 with field errors
    UI --> Professor: Preserve edits; highlight fields
  else Valid
    DAL -> DB: BEGIN
    DAL -> DB: UPDATE ProfessorProfile\nWHERE userId = actorId AND version = expectedVersion\nSET fields, version = version + 1
    alt No matching version / missing profile
      DB --> DAL: No row updated
      DAL -> DB: ROLLBACK
      DAL --> API: CONFLICT
      API --> UI: 409
      UI --> Professor: Preserve edits; offer explicit reload
    else Database failure
      DB --> DAL: Error
      DAL -> DB: ROLLBACK
      DAL --> API: Storage error
      API --> UI: 503 (no internal details)
      UI --> Professor: Preserve edits; retry available
    else Update succeeds
      DAL -> DB: Read saved profile and photo metadata
      DB --> DAL: Updated profile + new version
      DAL -> DB: COMMIT
      DAL --> API: Saved profile
      API --> UI: 200 + safe profile DTO
      UI --> Professor: Render saved data and confirmation
    end
  end
end
@enduml
